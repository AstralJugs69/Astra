# Environment discriminator (dev, test, prod)
ASTRA_ENV=dev

# Server settings
ASTRA_HOST=0.0.0.0
ASTRA_PORT=8080
ASTRA_AUTH_TOKEN=astra-dev-secret-token-change-in-prod

# Model & Provider settings
GEMINI_API_KEY=
ASTRA_FAST_MODEL=gemini-2.5-flash
ASTRA_DEEP_MODEL=gemini-2.5-pro
ASTRA_FAST_TIMEOUT_SECONDS=2.0
ASTRA_DEEP_TIMEOUT_SECONDS=8.0

# Persistence settings (IN_MEMORY for local dev/testing, FIRESTORE for cloud run)
ASTRA_PERSISTENCE_BACKEND=IN_MEMORY
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION_PREFIX=astra

# Escalation & Anti-Loop thresholds (Experimental, tuned via evaluation harness)
ASTRA_MAX_FORCED_CONTINUATIONS_PER_SIGNATURE=2
ASTRA_ANTI_LOOP_COOLDOWN_SECONDS=30.0
ASTRA_INTERVENTION_BUDGET_PER_SESSION=5

# Routing settings (return_to_main_agent, astra_reasons_further, combined)
ASTRA_ROUTING_MODE=return_to_main_agent

# Observability
ASTRA_LOG_LEVEL=INFO
ASTRA_VERBOSE_LOGS=true
