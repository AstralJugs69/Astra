APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
CLOUD_RUN_REGION=
GCS_ARTIFACT_BUCKET=
FIRESTORE_DATABASE=(default)
RUNTIME_SERVICE_ACCOUNT_EMAIL=

GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.5-flash
GEMINI_AUTH_MODE=attached-service-account
GEMINI_API_KEY_SECRET_NAME=

DRIVE_FILE_ID=
# Supported: text/markdown, or application/vnd.google-apps.document for a
# simple native Google Doc exported read-only to deterministic Markdown.
DRIVE_SOURCE_MIME_TYPE=text/markdown
# The private Cloud Scheduler job configured by
# infra/gcp/configure_automation_scheduler.ps1 performs the one-minute
# changes.list reconciliation cycle. Workspace Events and Pub/Sub are not
# configured in this release.

SOURCE_MAX_BYTES=1048576
ARTIFACT_MAX_BYTES=10485760
SEMANTIC_CONTEXT_CHARS=12000
# Each Gemini/ADK attempt is bounded to 90 seconds; the semantic execution
# lease reserves 240 seconds for two attempts and durable completion.
SEMANTIC_MODEL_TIMEOUT_SECONDS=90

TRANSLATION_PROFILE_ID=demo-ueb-40x25-v1
LIBLOUIS_EXPECTED_VERSION=3.38.0
LIBLOUIS_TABLEPATH=/opt/liblouis/share/liblouis/tables
BRAILLE_TRANSLATION_TABLE=en-ueb-g2.ctb
BRAILLE_DISPLAY_TABLE=en-us-brf.dis
BRAILLE_CELLS_PER_LINE=40
BRAILLE_LINES_PER_PAGE=25

INTERNAL_OIDC_AUDIENCE=
INTERNAL_SOURCE_PUSH_PRINCIPAL_EMAIL=
INTERNAL_TELEMETRY_PUSH_PRINCIPAL_EMAIL=
INTERNAL_SCHEDULER_PRINCIPAL_EMAIL=
DEMONSTRATOR_PRINCIPAL_EMAIL=
ENDPOINT_EVIDENCE_PRINCIPAL_EMAIL=

SITE_ID=demo-site
QUEUE_NAME=Braille-Embosser-Sim
SITE_OBSERVATION_MAX_AGE_SECONDS=15

DEMO_ROLE_PICKER_ENABLED=true
CSRF_SECRET_NAME=

# Local loopback presentation shell. Store actual non-secret values only in an
# ignored .env created by `braille-relay init-local-config`.
LOCAL_BRIDGE_ID=
RELAY_API_BASE_URL=
RELAY_API_AUDIENCE=
