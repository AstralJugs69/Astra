{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capture-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scheduler_job_id",
    "job_title",
    "state",
    "received_sha256",
    "completed_output_sha256",
    "byte_length_received",
    "pages_total",
    "pages_completed",
    "simulated_endpoint",
    "previous_event_sha256",
    "events_sha256",
    "terminal_event_sha256",
    "started_at",
    "finished_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "capture-manifest.v1"},
    "scheduler_job_id": {"type": "integer", "minimum": 1},
    "job_title": {"type": "string", "minLength": 1},
    "state": {"enum": ["ACCEPTED", "PROCESSING", "TERMINATED", "FAILED", "COMPLETED"]},
    "received_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "completed_output_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_length_received": {"type": "integer", "minimum": 0},
    "pages_total": {"type": "integer", "minimum": 0},
    "pages_completed": {"type": "integer", "minimum": 0},
    "simulated_endpoint": {"const": true},
    "previous_event_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "events_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}