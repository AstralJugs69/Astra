{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "professional-disposition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "incident_id", "decision", "selected_role",
    "expected_state_version", "idempotency_key", "note", "actor_principal", "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "professional-disposition.v1"},
    "record_id": {"$ref": "#/$defs/sha256"},
    "incident_id": {"$ref": "#/$defs/sha256"},
    "decision": {
      "enum": ["CONTINUE_ACCEPTED", "HALT_REQUESTED", "DEFERRED", "REPORT_REJECTED"]
    },
    "selected_role": {"const": "production_coordinator"},
    "expected_state_version": {"type": "integer", "minimum": 0},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "note": {"type": "string", "maxLength": 2000},
    "actor_principal": {"type": "string", "minLength": 1, "maxLength": 512},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
