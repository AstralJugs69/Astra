{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screenshot-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_identity",
    "truth_basis",
    "fixture_data_as_of",
    "screenshots",
    "sanitization_assertions"
  ],
  "properties": {
    "schema_version": {"const": "screenshot-manifest.v1"},
    "fixture_identity": {"const": "braille-errata-relay-sanitized-offline-v1"},
    "truth_basis": {"const": "SANITIZED_OFFLINE_DEMO_FIXTURE"},
    "fixture_data_as_of": {"type": "string", "format": "date-time"},
    "screenshots": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "route", "viewport", "sha256"],
        "properties": {
          "filename": {"type": "string", "pattern": "^[a-z0-9-]+\\.png$"},
          "route": {"type": "string", "pattern": "^/[a-z0-9/-]*$"},
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height", "device_scale_factor"],
            "properties": {
              "width": {"type": "integer", "minimum": 320},
              "height": {"type": "integer", "minimum": 480},
              "device_scale_factor": {"type": "integer", "minimum": 1, "maximum": 3}
            }
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "sanitization_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    }
  }
}
