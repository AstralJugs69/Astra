{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "site_id", "bridge_id", "queue_name", "sequence", "observed_at", "observations", "printer_state", "printer_state_reasons", "source"],
  "properties": {
    "schema_version": {"const": "site-observation.v1"},
    "observation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "site_id": {"type": "string", "minLength": 1},
    "bridge_id": {"type": "string", "minLength": 1},
    "queue_name": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "observations": {"type": "array"},
    "printer_state": {"type": "string"},
    "printer_state_reasons": {"type": "array", "items": {"type": "string"}},
    "previous_observation_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source": {"const": "cups_read_only_observer"}
  }
}
