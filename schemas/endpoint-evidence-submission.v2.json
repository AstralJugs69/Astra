{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "endpoint-evidence-submission.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "baseline_id", "production_link_id", "scheduler_job_id",
    "scheduler_job_title", "site_id", "queue_name", "simulated_endpoint_id",
    "approved_baseline_brf_sha256", "endpoint_received_sha256",
    "capture_manifest_sha256", "terminal_event_sha256", "capture_acceptance_sha256",
    "accepted_event_sha256", "previous_event_sha256", "capture_state",
    "evidence_timestamp", "truth_basis", "expected_baseline_state_version", "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "endpoint-evidence-submission.v2"},
    "baseline_id": {"$ref": "#/$defs/sha256"},
    "production_link_id": {"$ref": "#/$defs/sha256"},
    "scheduler_job_id": {"type": "integer", "minimum": 1},
    "scheduler_job_title": {"type": "string", "minLength": 1, "maxLength": 512},
    "site_id": {"const": "demo-site"},
    "queue_name": {"const": "Braille-Embosser-Sim"},
    "simulated_endpoint_id": {"const": "relay-capture://demo-embosser"},
    "approved_baseline_brf_sha256": {"$ref": "#/$defs/sha256"},
    "endpoint_received_sha256": {"$ref": "#/$defs/sha256"},
    "capture_manifest_sha256": {"$ref": "#/$defs/sha_or_null"},
    "terminal_event_sha256": {"$ref": "#/$defs/sha_or_null"},
    "capture_acceptance_sha256": {"$ref": "#/$defs/sha_or_null"},
    "accepted_event_sha256": {"$ref": "#/$defs/sha_or_null"},
    "previous_event_sha256": {"$ref": "#/$defs/sha_or_null"},
    "capture_state": {"enum": ["RECEIVED", "COMPLETED", "TERMINATED", "FAILED"]},
    "evidence_timestamp": {"type": "string", "format": "date-time"},
    "truth_basis": {"const": "SIMULATED_DEMO"},
    "expected_baseline_state_version": {"type": "integer", "minimum": 1},
    "idempotency_key": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"capture_state": {"const": "RECEIVED"}}},
      "then": {
        "properties": {
          "capture_manifest_sha256": {"type": "null"},
          "terminal_event_sha256": {"type": "null"},
          "capture_acceptance_sha256": {"$ref": "#/$defs/sha256"},
          "accepted_event_sha256": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {
          "capture_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "terminal_event_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha_or_null": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  }
}
