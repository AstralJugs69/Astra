{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-disposition-packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "baseline_id",
    "external_production_id",
    "report_sha256",
    "candidate_brf",
    "candidate_manifest",
    "candidate_label",
    "baseline_brf_sha256",
    "translation_profile_sha256",
    "braille_impact",
    "semantic_assessment",
    "site_observation_id",
    "observation_age_seconds",
    "recommended_human_steps",
    "blocking_reason",
    "authority_notice"
  ],
  "properties": {
    "schema_version": {"const": "human-disposition-packet.v1"},
    "incident_id": {"$ref": "#/$defs/sha256"},
    "baseline_id": {"$ref": "#/$defs/sha256"},
    "external_production_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_brf": {"$ref": "#/$defs/artifact_ref"},
    "candidate_manifest": {"$ref": "#/$defs/artifact_ref"},
    "candidate_label": {"const": "CANDIDATE_NOT_APPROVED_PRODUCTION_MASTER"},
    "baseline_brf_sha256": {"$ref": "#/$defs/sha256"},
    "translation_profile_sha256": {"$ref": "#/$defs/sha256"},
    "braille_impact": {"type": "object"},
    "semantic_assessment": {"type": "object"},
    "site_observation_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "observation_age_seconds": {"type": ["number", "null"], "minimum": 0},
    "recommended_human_steps": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "blocking_reason": {"type": ["string", "null"]},
    "authority_notice": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "kind", "byte_length", "uri"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 0},
        "uri": {"type": "string", "pattern": "^gs://"}
      }
    }
  }
}
