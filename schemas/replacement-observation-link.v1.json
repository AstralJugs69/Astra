{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replacement-observation-link.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "incident_id",
    "approved_candidate_sha256",
    "candidate_manifest_sha256",
    "proof_record_id",
    "candidate_label",
    "original_scheduler_job_id",
    "scheduler_job_id",
    "observed_job_title",
    "site_id",
    "bridge_id",
    "queue_name",
    "site_observation_id",
    "observed_job_state",
    "observed_at",
    "truth_basis",
    "selected_role",
    "expected_state_version",
    "idempotency_key",
    "note",
    "actor_principal",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "replacement-observation-link.v1"},
    "record_id": {"$ref": "#/$defs/sha256"},
    "incident_id": {"$ref": "#/$defs/sha256"},
    "approved_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "proof_record_id": {"$ref": "#/$defs/sha256"},
    "candidate_label": {"const": "CANDIDATE_NOT_APPROVED_PRODUCTION_MASTER"},
    "original_scheduler_job_id": {"type": "integer", "minimum": 1},
    "scheduler_job_id": {"type": "integer", "minimum": 1},
    "observed_job_title": {"type": "string", "minLength": 1, "maxLength": 512},
    "site_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "bridge_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "queue_name": {"type": "string", "minLength": 1, "maxLength": 512},
    "site_observation_id": {"$ref": "#/$defs/sha256"},
    "observed_job_state": {
      "enum": [
        "PENDING",
        "PENDING_HELD",
        "PROCESSING",
        "PROCESSING_STOPPED",
        "CANCELED",
        "ABORTED",
        "COMPLETED"
      ]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "truth_basis": {"const": "HUMAN_SUBMITTED_EXTERNAL_JOB_PLUS_READ_ONLY_OBSERVATION"},
    "selected_role": {"const": "machine_operator"},
    "expected_state_version": {"type": "integer", "minimum": 0},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "note": {"type": "string", "maxLength": 2000},
    "actor_principal": {"type": "string", "minLength": 1, "maxLength": 512},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
